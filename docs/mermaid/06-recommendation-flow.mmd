%% Prism deterministic recommendation and adoption flow
%% verified: 2026-07-18 active cap + versioned verification contract
%% files: apps/web/lib/recommendations/engine.ts, apps/web/lib/recommendations/store.ts, apps/web/lib/recommendations/contract.ts, apps/web/lib/adoption/monitor.ts, apps/web/app/api/actions/recommendations/route.ts
%% granularity: full
flowchart TD
  A["Assemble recommendation context<br/>[FUNCTION]<br/>in: real KPI, PR, session, skill, and course rows<br/>out: one employee RuleContext"] --> B["Evaluate ordered rule registry<br/>[FUNCTION]<br/>in: RuleContext and frozen thresholds<br/>out: zero or more rule candidates"]
  B --> C{"Candidate has real denominator?<br/>[FUNCTION]<br/>condition: rule-specific signal count above zero"}
  C -->|"no"| X["Emit nothing<br/>[RESULT]<br/>in: absent evidence<br/>out: no recommendation"]
  C -->|"yes"| D["Check existing open slot<br/>[DATA · recommendations]<br/>in: employee, kind, stable reference<br/>out: duplicate or new candidate"]
  D --> E{"Duplicate or active cap reached?<br/>[FUNCTION]<br/>gate: at most three active recommendations"}
  E -->|"yes"| Y["Skip candidate<br/>[RESULT]<br/>in: duplicate or lower-priority overflow<br/>out: no new row"]
  E -->|"no"| F["Attach action contract<br/>[FUNCTION]<br/>in: fired rule and measured evidence<br/>out: action, expected signal, verification, guard"]
  F --> G["Persist recommendation trace<br/>[DATA · recommendations.evidence_jsonb]<br/>in: rule, rank, evidence, stages, action contract<br/>out: suggested recommendation"]
  G --> H["Developer records intent<br/>[USER ACTION]<br/>in: acknowledge, start, action, or dismiss<br/>out: audited action event"]
  H --> I["Store action event<br/>[DATA · recommendation_action_events]<br/>in: employee action and timestamp<br/>out: workflow history"]
  I --> J["Load later measured window<br/>[FUNCTION]<br/>in: same rule context on later date<br/>out: verified signal and target"]
  J --> K{"Adoption predicate satisfied?<br/>[FUNCTION]<br/>condition: rule-specific measured evidence"}
  K -->|"not yet"| L["Keep in progress<br/>[RESULT]<br/>in: intent without confirming evidence<br/>out: no impact claim"]
  K -->|"yes"| M["Mark adopted<br/>[RESULT]<br/>in: verified later evidence<br/>out: adopted status with audit snapshot"]
  class A,B,F,J fn;
  class C,E,K dec;
  class D,G,I data;
  class H ask;
  class X,Y,L,M term;
  classDef agent fill:#dbeafe,stroke:#2563eb,color:#0b2a5b;
  classDef fn fill:#dcfce7,stroke:#16a34a,color:#052e16;
  classDef dec fill:#f3e8ff,stroke:#9333ea,color:#2a0a4a;
  classDef term fill:#e5e7eb,stroke:#6b7280,color:#111827;
  classDef ask fill:#cffafe,stroke:#0891b2,color:#083344;
  classDef data fill:#ede9fe,stroke:#7c3aed,color:#2a0a4a;
