%% Prism evidence-bound insight generation
%% verified: 2026-07-18 versioned trace + privacy-safe organization aggregation
%% files: apps/web/lib/agents/assemble.ts, apps/web/lib/agents/graph.ts, apps/web/lib/agents/nodes/improvement-area.ts, apps/web/lib/agents/nodes/improvement-attribution.ts, apps/web/lib/agents/nodes/change-governance.ts, apps/web/lib/agents/nodes/ground-run.ts, apps/web/lib/agents/run.ts
%% granularity: full
flowchart TD
  A["Load scored scope<br/>[DATA · index_daily and kpi_daily]<br/>in: function or employee id plus run date<br/>out: persisted score and KPI rows"] --> B{"Scope type?<br/>[FUNCTION]<br/>condition: function or employee"}
  B -->|"employee"| C["Build employee facts<br/>[FUNCTION]<br/>in: employee KPI rows<br/>out: direct typed KPI evidence"]
  B -->|"function"| D["Build privacy-safe organization facts<br/>[FUNCTION]<br/>in: active employee KPI rows<br/>out: median, coverage, and signal totals without identities"]
  C --> E["Compute candidates<br/>[FUNCTION]<br/>in: typed KPI evidence and frozen anchors<br/>out: ranked gaps, strengths, and measured deltas"]
  D --> E
  E --> F{"Publishable scope?<br/>[FUNCTION]<br/>gate: confidence at least 0.40 and evidence count above zero"}
  F -->|"no"| X["Publish no insight<br/>[RESULT]<br/>in: insufficient evidence<br/>out: honest empty state"]
  F -->|"yes"| G["Fan out three batched narrative lanes<br/>[AGENT · configured Anthropic narrator]<br/>in: immutable gaps, strengths, movements, and typed evidence<br/>out: one structured call per non-empty lane; maximum concurrency three"]
  G --> H["Validate every item independently<br/>[FUNCTION]<br/>in: structured prose plus evidence ids<br/>out: accepted items and per-item violations"]
  H --> I{"Grounding clean?<br/>[FUNCTION]<br/>condition: every number and evidence id resolves"}
  I -->|"no · first attempt"| J["Build one shared repair batch<br/>[FUNCTION]<br/>in: only rejected item indexes and content-free violations<br/>out: bounded corrective constraints"]
  J --> G
  I -->|"no · repaired attempt"| Y["Drop candidate<br/>[RESULT]<br/>in: repeated grounding failure<br/>out: no persisted narrative"]
  I -->|"yes"| K["Join exact candidate id and attach deterministic priority<br/>[FUNCTION]<br/>in: accepted prose plus score-stamped config facts<br/>out: correctly owned artifact and versioned trace"]
  K --> L["Persist insight slot<br/>[DATA · insights.evidence_jsonb]<br/>in: narrative, cited snapshot, stages, validation<br/>out: idempotent scope, date, kind, rank row"]
  L --> M{"Read surface?<br/>[FUNCTION]<br/>condition: organization or personal scope"}
  M -->|"organization"| N["Overview major insights<br/>[RESULT]<br/>in: organization-only rows<br/>out: at most three strengths and three opportunities"]
  M -->|"personal"| O["My View detailed coaching<br/>[RESULT]<br/>in: employee rows<br/>out: full reasoning and verification contract"]
  class A,L data;
  class B,F,I,M dec;
  class C,D,E,H,J,K fn;
  class G agent;
  class X,Y,N,O term;
  classDef agent fill:#dbeafe,stroke:#2563eb,color:#0b2a5b;
  classDef fn fill:#dcfce7,stroke:#16a34a,color:#052e16;
  classDef dec fill:#f3e8ff,stroke:#9333ea,color:#2a0a4a;
  classDef term fill:#e5e7eb,stroke:#6b7280,color:#111827;
  classDef ask fill:#cffafe,stroke:#0891b2,color:#083344;
  classDef data fill:#ede9fe,stroke:#7c3aed,color:#2a0a4a;
