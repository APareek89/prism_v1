# ─────────────────────────────────────────────────────────────────────────────
# Prism — environment contract (committed template). Copy to .env.local and fill.
# The app BOOTS KEYLESS: only the Supabase vars are needed to run M1; connector
# and agent keys are optional and surface as "not configured" in Admin until set.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=local                 # local | production
DEMO_MODE=true                # true → local dev sign-in bypass (real RLS still on)
DEMO_USER_EMAIL=              # your email; the bootstrap is_demo employee
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (required to run the app) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ── Anthropic (M4 agents only — your "Claude Code API" key) ──────────────────
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-4-5

# ── GitHub App (M2 — connect a repo you own) ─────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# ── Claude Code telemetry (M2) ───────────────────────────────────────────────
# Demo path: read your local session files. Default ~/.claude.
CLAUDE_LOCAL_SESSIONS_DIR=~/.claude
# Production OTEL path (stubbed for MVP — leave unset for the demo):
# OTEL_INGEST_URL=
# OTEL_STORE_URL=

# ── Sentry (M2 — optional; free Developer tier) ──────────────────────────────
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Email digest (M4 — Resend; sent by a Supabase Edge Function) ─────────────
# RESEND_API_KEY is held ONLY by the send-digest Edge Function (set it via
# `supabase secrets set`), never the Next app. Left blank here, the digest queues
# but does not send (keyless-safe no-op).
RESEND_API_KEY=
DIGEST_FROM_EMAIL=
# Svix signing secret for the Resend open/delivery webhook (starts with "whsec_").
# Blank ⇒ /api/webhooks/resend rejects unsigned callbacks (no DB patch).
RESEND_WEBHOOK_SECRET=
# SMTP fallback (commented; use instead of Resend if preferred):
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# ── Inngest (M4 pipeline; not needed for `inngest dev` locally) ──────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Learning studio (M4 — pre-generated micro-courses) ───────────────────────
LEARNING_STUDIO_BASE_URL=
