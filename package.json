{
  "name": "prism-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/contract",
    "services/engine",
    "services/ingest",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:scoring": "npm run test:scoring --workspace apps/web",
    "test:engine": "npm run test --workspace services/engine",
    "db:migrate": "npm run db:migrate --workspace apps/web",
    "demo:reset": "npm run demo:reset --workspace apps/web",
    "inngest:dev": "npm run inngest:dev --workspace apps/web",
    "v3:migrate": "npm run migrate --workspace services/ingest",
    "v3:seed": "npm run seed --workspace services/ingest",
    "v3:reset": "npm run reset --workspace services/ingest",
    "v3:recompute": "npm run recompute --workspace services/engine"
  }
}
